<Window x:Class="ChessApp.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login CoreChess" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#312e2b">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CoreChess" FontSize="32" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Username" Foreground="Gray" Margin="0,5"/>
            <TextBox x:Name="txtUser" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Password" Foreground="Gray" Margin="0,5"/>
            <PasswordBox x:Name="txtPass" Margin="0,0,0,15" Padding="5"/>


            <Button Content="Log in" Click="BtnLogin_Click"
                    Height="40" Margin="0,5" Background="#81b64c" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0"/>

            <Button Content="Create Account" Click="BtnOpenRegister_Click"
            Height="30" Margin="0,10" Background="Transparent" Foreground="#AAAAAA" 
            BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" 
                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>