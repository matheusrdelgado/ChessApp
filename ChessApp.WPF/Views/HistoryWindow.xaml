<Window x:Class="ChessApp.WPF.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match History" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" Background="#312e2b">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Your Matches" Grid.Row="0"
                   Foreground="White" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" 
                     ItemsSource="{Binding HistoryFiles}" 
                     SelectedItem="{Binding SelectedFile}"
                     Background="#403d39" BorderThickness="0" Foreground="White" 
                     Margin="0,0,10,0"/>

            <Border Grid.Column="1" Background="#262421" CornerRadius="5" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding MatchDetails}" 
                               Foreground="#cccccc" FontFamily="Consolas" FontSize="14" 
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" 
                   Foreground="#ff5555" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"
                   IsHitTestVisible="False"/>

        <Button Content="Close" Grid.Row="2"
                Command="{Binding CloseCommand}"
                Height="35" Width="100" Margin="0,15,0,0"
                Background="#aa3333" Foreground="White" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>