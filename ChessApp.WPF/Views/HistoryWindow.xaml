<Window x:Class="ChessApp.WPF.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Partidas" Height="400" Width="300"
        WindowStartupLocation="CenterScreen" Background="#312e2b">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="As tuas Partidas" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <ListBox x:Name="ListHistory" Grid.Row="1" Background="#404040" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>

        <Button Content="Fechar" Click="BtnClose_Click" Grid.Row="2"
                Height="30" Background="#aa3333" Foreground="White" BorderThickness="0"/>
    </Grid>
</Window>