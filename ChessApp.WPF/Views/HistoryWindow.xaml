<Window x:Class="ChessApp.WPF.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match History" Height="400" Width="300"
        WindowStartupLocation="CenterScreen" Background="#312e2b">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Your Matches" Grid.Row="0"
                   Foreground="White" FontSize="18" FontWeight="Bold" 
                   Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding HistoryFiles}" Background="#403d39" BorderThickness="0" Foreground="White" />

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" 
                   Foreground="#ff5555" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <Button Content="Close" Grid.Row="2"
                Command="{Binding CloseCommand}"
                Height="30" Margin="0,10,0,0"
                Background="#aa3333" Foreground="White" BorderThickness="0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>