<Window x:Class="ChessApp.WPF.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#312e2b">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="New User" FontSize="28" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Username" Foreground="Gray" Margin="0,5"/>
            <TextBox x:Name="txtRegUser" 
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Password" Foreground="Gray" Margin="0,5"/>
            <PasswordBox x:Name="txtRegPass" Margin="0,0,0,15" Padding="5"/>

            <TextBlock Text="Repeat Password" Foreground="Gray" Margin="0,5"/>
            <PasswordBox x:Name="txtRegConfirm" Margin="0,0,0,20" Padding="5"/>

            <Button Content="REGISTER" 
                    Command="{Binding RegisterCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="40" Margin="0,5" Background="#81b64c" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0"/>

            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Height="30" Margin="0,10" Background="Transparent" Foreground="#FF6666" 
                    BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </Grid>
</Window>